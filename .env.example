NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/housing_roommate?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/housing_roommate?schema=public"

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

ADMIN_EMAIL=admin@housing.com
ADMIN_PASSWORD=ChangeMeAdmin123!

# --- Email (same as PH Healthcare locally) ---
# Local: Gmail App Password → Nodemailer service "gmail" (works on your PC)
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_SENDER=your@gmail.com
SMTP_FROM=your@gmail.com
#
# WHY Render fails with the same Gmail SMTP as PH:
# Render free web services BLOCK outbound SMTP ports 25, 465, 587.
# PH Healthcare works because you run it locally (or on a host that allows SMTP).
#
# Real inbox on Render → Brevo HTTPS API (not SMTP):
# https://app.brevo.com → SMTP & API → API key + verify sender
BREVO_API_KEY=
# When true, if email fails (Render without Brevo), OTP is returned in API body
ALLOW_OTP_IN_RESPONSE=true

REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=18952

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:5000/api/v1
