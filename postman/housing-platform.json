          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tenantToken}}" }],
            "url": "{{baseUrl}}/bookings/my"
          }
        },
        {
          "name": "Get Booking By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tenantToken}}" }],
            "url": "{{baseUrl}}/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{tenantToken}}" }],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "7. Payments",
      "item": [
        {
          "name": "Initiate Stripe Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data;",
                  "  if (d.payment && d.payment.id) {",
                  "    pm.collectionVariables.set('paymentId', d.payment.id);",
                  "  }",
                  "  console.log('Stripe checkoutUrl:', d.checkoutUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"gateway\": \"STRIPE\"\n}"
            },
            "url": "{{baseUrl}}/payments/initiate",
            "description": "Creates a Stripe Checkout session for the booking (charged in STRIPE_CURRENCY, BDT by default). Open checkoutUrl in a browser and pay with the test card 4242 4242 4242 4242, any future date and any CVC. Stripe then calls the webhook to mark the payment PAID; when running locally keep `stripe listen --forward-to localhost:5000/api/v1/payments/webhook` running."
          }
        },
        {
          "name": "Initiate bKash Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json().data;",
                  "  if (d.payment && d.payment.id) {",
                  "    pm.collectionVariables.set('paymentId', d.payment.id);",
                  "  }",
                  "  console.log('bKash checkoutUrl:', d.checkoutUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"gateway\": \"BKASH\"\n}"
            },
            "url": "{{baseUrl}}/payments/initiate",
            "description": "Open checkoutUrl. Sandbox wallet 01770618575, OTP 123456, PIN 12121. For callback locally use ngrok + BKASH_CALLBACK_URL."
          }
        },
        {
          "name": "bKash Callback (docs only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/bkash/callback?paymentID=PAYMENT_ID&status=success",
            "description": "Called by bKash after payment. Do not call manually unless debugging."
          }
        },
        {
          "name": "Stripe Webhook (docs only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/payments/webhook",
            "description": "Called by Stripe with a signed event (verified with STRIPE_WEBHOOK_SECRET); checkout.session.completed marks the payment PAID, and failed or expired sessions are recorded too. Requests without a valid Stripe-Signature header are rejected, so do not call it manually."
          }
        },
        {
          "name": "My Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tenantToken}}" }],
            "url": "{{baseUrl}}/payments/my"
          }
        },
        {
          "name": "Get Payment By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tenantToken}}" }],
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          }
        }
      ]
    },
